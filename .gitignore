# ============================================================
# Livestock 360° - Git Ignore Configuration
# ============================================================

# Environment variables & secrets
.env
.env.local
.env.*.local

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Virtual environments
venv/
ml_venv/
env/
ENV/
env.bak/
venv.bak/

# Django media & collected static
staticfiles/
media/

# Note: Production ML models in ai_engine are intentionally tracked:
# ai_engine/model.pkl
# ai_engine/disease_model.pkl

# Databases (SQLite if ever used)
*.sqlite3
*.db

# IDE and Operating System files
.vscode/
.idea/
*.swp
*.swo
*~
Thumbs.db
Desktop.ini
.DS_Store
